# FarmLink AI - Environment Variables Template
# Copy this file to .env and fill in your actual values

# Application URL (REQUIRED for production)
# Local: http://localhost:5000
# Production: https://your-app-name.onrender.com
BASE_URL=https://your-app-name.onrender.com

# AI API Keys
GEMINI_API_KEY=your_gemini_api_key_here
WEATHER_API_KEY=your_weather_api_key_here

# Crop AI Configuration
# Enable strict validation mode to reject low-quality AI responses
CROP_AI_STRICT_MODE=true
# Minimum acceptable data quality score (0-100)
CROP_AI_MIN_QUALITY_SCORE=70

# Database Configuration - PostgreSQL
# Local development
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/farmlink_db
# Production (Render will provide this automatically)

# Email Configuration - SendGrid (Recommended for Production)
# Sign up at https://sendgrid.com (Free tier: 100 emails/day)
# Get your API key from: https://app.sendgrid.com/settings/api_keys
SENDGRID_API_KEY=your_sendgrid_api_key_here
SENDGRID_FROM_EMAIL=your_verified_sender@yourdomain.com

# Email Configuration - SMTP Fallback (Optional)
# IMPORTANT: For Gmail, you MUST use an App Password, not your regular password
# To generate Gmail App Password:
# 1. Go to https://myaccount.google.com/security
# 2. Enable 2-Step Verification if not already enabled
# 3. Go to https://myaccount.google.com/apppasswords
# 4. Generate a new app password for "Mail"
# 5. Copy the 16-character password (without spaces) and use it below
FLASK_APP=app.py
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USE_SSL=False
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_16_char_app_password_here
MAIL_DEFAULT_SENDER=your_email@gmail.com
FLASK_DEBUG=0
SESSION_SECRET=generate-a-strong-random-secret-key-here

# Price Forecast API Keys
DATA_GOV_IN_API_KEY=your_data_gov_api_key_here

# Agmarknet API Configuration
AGMARKNET_BASE_URL=https://api.data.gov.in/resource/9ef84268-d588-465a-a308-a864a43d0070
AGMARKNET_API_KEY=your_agmarknet_api_key_here

# Price Cache Configuration
PRICE_CACHE_TTL=21600  # 6 hours in seconds
PRICE_CACHE_MAX_SIZE_MB=100

# Forecast Configuration
DEFAULT_FORECAST_MODEL=exponential_smoothing  # Options: moving_average, exponential_smoothing
FORECAST_CONFIDENCE_THRESHOLD=60  # Minimum confidence percentage to display forecast

# API Configuration
API_RATE_LIMIT_PER_MINUTE=30
API_TIMEOUT_SECONDS=10

# Circuit Breaker Configuration
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
CIRCUIT_BREAKER_TIMEOUT_SECONDS=60

# Password Reset Configuration
PASSWORD_RESET_SALT=generate-random-salt-here
OTP_SECRET_KEY=generate-random-otp-key-here
PASSWORD_RESET_TIMEOUT=3600
BASE_URL=https://your-app-name.onrender.com

# Razorpay Configuration
RAZORPAY_KEY_ID=your_razorpay_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here

# AI Cache Configuration
AI_CACHE_DIR=ai_cache
AI_CACHE_MAX_AGE_HOURS=24
AI_RATE_LIMIT_PER_HOUR=100

# Encryption Keys (Generate using: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
ENCRYPTION_KEY=generate_encryption_key_here
KYC_ENCRYPTION_KEY=generate_kyc_encryption_key_here
KYC_UPLOAD_DIR=uploads/kyc
KYC_MAX_FILE_SIZE=5242880

# Shipment Tracking Configuration
SHIPROCKET_EMAIL=your_shiprocket_email@example.com
SHIPROCKET_PASSWORD=your_shiprocket_password
SHIPROCKET_WEBHOOK_SECRET=your_shiprocket_webhook_secret

# India Post API Configuration
INDIA_POST_API_KEY=your_india_post_api_key
INDIA_POST_CLIENT_ID=your_india_post_client_id
INDIA_POST_WEBHOOK_SECRET=your_india_post_webhook_secret

# Twilio SMS Configuration
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# Tracking System Configuration
TRACKING_POLL_INTERVAL=14400
WEBHOOK_RATE_LIMIT=100

# Production Settings (for Render deployment)
USE_JSON_LOGGING=true
